      <a href="/book">contact us</a>.
    </p>
  </section>
</PageLayout>

<style>
  .prose {
    max-width: 70ch;
    padding-block: var(--space-8);
  }

  .prose h2 {
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    margin-top: var(--space-8);
  }
</style>
