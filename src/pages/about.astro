---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { dancers } from '../data/dancers';
import { SMS_HREF, SMS_NUMBER_DISPLAY, smsBookHref } from '../lib/site';

// Every person bio'd on this page comes from src/data/dancers.ts, where each
// entry carries its OWN photo (src/assets/dancers/<slug>.jpg — matched by slug).
// All 13 bio'd performers have a photo, so no monogram placeholder is needed;
// if one is ever added without a photo, the card falls back to a gold initial.
---

<BaseLayout
  title="Our Dancers - About Us - Burlesque To Go - Book Now!"
  description="Burlesque To Go offers a wide variety of Las Vegas Burlesque Dancers available for performances at your next event or party!"
>
  <!-- Page hero -->
  <header class="about-hero">
    <div class="container">
      <p class="eyebrow">About Us</p>
      <h1>Burlesque To Go</h1>
      <p class="intro">
        Burlesque To Go offers a wide variety of Las Vegas Burlesque Dancers available for
        performances at your next event or party! Las Vegas burlesque dancers, on demand.
      </p>
      <div class="deco-divider hero-divider"><span>◆</span></div>
    </div>
  </header>

  <!-- One generous profile card per person, photo matched by slug -->
  <section class="container profiles" aria-label="Our dancers">
    {dancers.map((d, i) => (
      <>
        {i > 0 && <div class="deco-divider"><span>◆</span></div>}
        <article class={`profile-card deco-frame${i % 2 === 1 ? ' is-flipped' : ''}`}>
          <div class="portrait">
            {d.image ? (
              <div class="photo-frame">
                <Image
                  src={d.image}
                  alt={d.imageAlt}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 900px) 40vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ) : (
              <div class="monogram photo-frame" aria-hidden="true">
                <span>{d.name.charAt(0)}</span>
              </div>
            )}
          </div>
          <div class="details">
            <p class="role">{d.jobTitle}</p>
            <h2>{d.name}</h2>
            {d.bio.map((p) => <p class="bio-text">{p}</p>)}
            <div class="actions">
              <Button href={smsBookHref(d.name)} variant="ghost">Book {d.name}</Button>
              <a class="full-profile" href={`/dancers/${d.slug}`}>Full profile →</a>
            </div>
          </div>
        </article>
      </>
    ))}
  </section>

  <!-- Full-width booking CTA band -->
  <section class="cta-band">
    <div class="container">
      <h2>Ready for the Show?</h2>
      <p>The fastest way to book is by text — tell us your event date and your favorite performer.</p>
      <div class="cta-actions">
        <Button href={SMS_HREF} variant="primary" size="lg">Text to Book {SMS_NUMBER_DISPLAY}</Button>
        <Button href="/dancers" variant="ghost" size="lg">Browse the Roster</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .about-hero {
    padding-block: var(--space-section) var(--space-8);
    text-align: center;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .about-hero h1 {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: var(--space-3) 0 0 0;
  }

  .about-hero .intro {
    max-width: 62ch;
    margin: var(--space-5) auto 0;
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
    line-height: var(--lh-loose);
  }

  .hero-divider {
    max-width: 420px;
    margin-inline: auto;
    margin-block: var(--space-8) 0;
  }

  /* Profile cards */
  .profiles {
    padding-top: var(--space-16);
  }

  .profiles > .deco-divider {
    max-width: 520px;
    margin-inline: auto;
    margin-block: var(--space-16);
  }

  .profile-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    min-width: 0;
  }

  @media (min-width: 900px) {
    .profile-card {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-12);
      padding: var(--space-10);
    }

    .profile-card.is-flipped .portrait {
      order: 2;
    }

    .profile-card.is-flipped .details {
      order: 1;
    }
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
  }

  .monogram {
    aspect-ratio: 3 / 4;
    display: grid;
    place-items: center;
    background: var(--color-bg);
  }

  .monogram span {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: var(--fw-bold);
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--color-primary);
    -webkit-text-fill-color: transparent;
  }

  .details {
    min-width: 0;
    max-width: 65ch;
  }

  .role {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--color-pink-soft);
  }

  .details h2 {
    margin: 0 0 var(--space-5) 0;
    font-size: var(--fs-3xl);
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--color-primary);
    -webkit-text-fill-color: transparent;
  }

  .bio-text {
    margin: 0 0 var(--space-4) 0;
    color: var(--color-text-muted);
    line-height: var(--lh-loose);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .full-profile {
    color: var(--color-primary);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  .full-profile:hover {
    color: var(--color-pink-soft);
    text-decoration: underline;
    text-decoration-color: var(--color-pink);
  }

  /* CTA band */
  .cta-band {
    margin-top: var(--space-section);
    padding-block: var(--space-20);
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 120%, rgb(210 55 128 / 0.12), transparent 60%),
      var(--color-surface);
    border-top: 1px solid var(--color-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .cta-band h2 {
    margin: 0;
  }

  .cta-band p {
    color: var(--color-text-muted);
    margin: var(--space-4) auto 0;
    max-width: 55ch;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-8);
  }
</style>
