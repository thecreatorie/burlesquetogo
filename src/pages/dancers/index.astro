---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import DancerCard from '../../components/DancerCard.astro';
import Button from '../../components/Button.astro';
import { dancers, femaleDancers, boylesque } from '../../data/dancers';
import { SITE_URL, SMS_HREF, SMS_NUMBER_DISPLAY } from '../../lib/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/dancers#collection`,
  name: 'Meet Our Dancers',
  url: `${SITE_URL}/dancers`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: dancers.map((d, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: d.name,
      url: `${SITE_URL}/dancers/${d.slug}`,
    })),
  },
};
---

<PageLayout
  title="Meet Our Dancers | Burlesque To Go"
  description="Meet the Burlesque To Go roster: Las Vegas burlesque dancers, aerialists, pole champions and Cirque du Soleil alumni available to book for your event."
  eyebrow="The Roster"
  heading="Meet Our Dancers"
  intro="Every performer on this roster is a working Las Vegas entertainer. Pick your favorite — or let us match you with the perfect act for your event."
  schema={schema}
>
  <section class="container">
    <div class="dancer-grid">
      {femaleDancers.map((d, i) => (
        <DancerCard dancer={d} loading={i < 3 ? 'eager' : 'lazy'} />
      ))}
    </div>
  </section>

  <div class="container"><div class="deco-divider"><span>◆</span></div></div>

  <section class="container">
    <SectionHeader
      eyebrow="Boylesque"
      title="The men of Burlesque To Go"
      description="Male burlesque performers for bachelorette parties, birthdays, and more."
    />
    <div class="dancer-grid">
      {boylesque.map((d) => <DancerCard dancer={d} />)}
    </div>
    <p class="group-link"><a href="/dancers/boylesque">More about Boylesque →</a></p>
  </section>

  <section class="container">
    <div class="cta deco-frame">
      <h2>Found your headliner?</h2>
      <p>Text us the name and your event date — we handle the rest.</p>
      <Button href={SMS_HREF} variant="primary" size="lg">Text {SMS_NUMBER_DISPLAY}</Button>
    </div>
  </section>
</PageLayout>

<style>
  .container {
    padding-block: var(--space-8) 0;
  }

  .dancer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12) var(--space-8);
  }

  @media (min-width: 640px) {
    .dancer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .dancer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .group-link {
    margin-top: var(--space-8);
    text-align: center;
  }

  .group-link a {
    color: var(--color-primary);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
  }

  .group-link a:hover {
    text-decoration: underline;
  }

  .cta {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .cta h2 {
    margin: 0 0 var(--space-3) 0;
  }

  .cta p {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6) 0;
  }
</style>
