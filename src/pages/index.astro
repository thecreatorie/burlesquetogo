---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import DancerCard from '../components/DancerCard.astro';
import { featuredDancers } from '../data/dancers';
import heroImage from '../assets/dancers/fawnia.jpg';
import {
  SITE_URL,
  SMS_HREF,
  SMS_NUMBER_DISPLAY,
  PHONE_HREF,
  PHONE_DISPLAY,
  PRICING,
  PRICING_NOTE,
  ORGANIZATION_SCHEMA,
  LOCAL_BUSINESS_SCHEMA,
} from '../lib/site';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ORGANIZATION_SCHEMA,
    LOCAL_BUSINESS_SCHEMA,
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: 'Burlesque To Go',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};
---

<BaseLayout
  title="Burlesque Dancers Delivered To You In Las Vegas - Burlesque To Go"
  description="Spice up your next event with a performance by Burlesque Dancers from Burlesque To Go! We have beautiful ladies that will be the cherry on top at your event."
  schema={schema}
>
  <!-- Full-bleed photo hero -->
  <section class="hero-photo">
    <Image
      class="bg"
      src={heroImage}
      alt="Fawnia, headlining Las Vegas burlesque performer, posing on stage"
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim" aria-hidden="true"></div>
    <div class="copy">
      <p class="eyebrow">Las Vegas · On-Demand Entertainment</p>
      <h1>Burlesque To Go</h1>
      <p class="subtitle">World-class burlesque entertainers, delivered to your event.</p>
      <div class="ctas">
        <Button href="/book" variant="primary" size="lg">Book Now</Button>
        <Button href="/dancers" variant="ghost" size="lg">Meet the Dancers</Button>
      </div>
    </div>
  </section>

  <div class="container"><div class="deco-divider"><span>◆</span></div></div>

  <!-- What is Burlesque? -->
  <section class="container what-is-section">
    <SectionHeader
      eyebrow="The art of the tease"
      title="What is Burlesque?"
      align="center"
    />
    <div class="what-is">
      <p>
        With burlesque, the aim is to tease and insinuate nudity, without exposing it all.
        Burlesque is not performed in seedy men’s clubs, but at all kinds of venues and events
        with a variety of audiences. Burlesque can often be confused with stripping, however the
        two are very different forms of dance. How so? Continue reading to find out!
      </p>
      <div class="ctas">
        <Button href="/book" variant="primary">Book A Performance</Button>
        <Button href="/what-is-burlesque" variant="ghost">Learn More</Button>
      </div>
    </div>
  </section>

  <div class="container"><div class="deco-divider"><span>◆</span></div></div>

  <!-- Pricing -->
  <section class="container">
    <SectionHeader
      eyebrow="Our Prices"
      title="Performance Options"
      description="Every performance happens at the location of your choice."
      align="center"
    />
    <div class="pricing-grid">
      {PRICING.map((tier, i) => (
        <div class={`card price-card${i === 1 ? ' deco-frame is-popular' : ''}`}>
          {i === 1 && <p class="popular">Most Popular</p>}
          <p class="tier-dancers">{tier.dancers}</p>
          <h3>{tier.name}</h3>
          <p class="price">{tier.price}</p>
          <ul>
            {tier.details.map((d) => <li>{d}</li>)}
          </ul>
          <Button href="/book" variant={i === 1 ? 'primary' : 'ghost'} fullWidth>Book Now</Button>
        </div>
      ))}
    </div>
    <p class="pricing-note">{PRICING_NOTE}</p>
  </section>

  <div class="container"><div class="deco-divider"><span>◆</span></div></div>

  <!-- Featured dancers -->
  <section class="container">
    <SectionHeader
      eyebrow="Meet Our Dancers"
      title="The Stars of the Show"
      description="Pole champions, Cirque du Soleil alumni, aerialists, and headliners from the Las Vegas strip."
      align="center"
    />
    <div class="dancer-grid">
      {featuredDancers.map((d) => <DancerCard dancer={d} />)}
    </div>
    <div class="center">
      <Button href="/dancers" variant="ghost" size="lg">See the Full Roster</Button>
    </div>
  </section>

  <div class="container"><div class="deco-divider"><span>◆</span></div></div>

  <!-- Booking CTA -->
  <section class="container">
    <div class="booking-cta deco-frame">
      <h2>Need more information? Ready to Book?</h2>
      <p>Contact us! The fastest way to book is by text.</p>
      <div class="ctas">
        <Button href={SMS_HREF} variant="primary" size="lg">Text {SMS_NUMBER_DISPLAY}</Button>
        <Button href={PHONE_HREF} variant="secondary" size="lg">Call {PHONE_DISPLAY}</Button>
        <Button href="/book" variant="ghost" size="lg">Send A Message</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Deep red-black tint at the base of the hero scrim */
  .hero-photo .scrim {
    background: linear-gradient(
      180deg,
      rgb(11 8 6 / 0.55) 0%,
      rgb(11 8 6 / 0.35) 45%,
      rgb(26 10 13 / 0.94) 100%
    );
  }

  .hero-photo .subtitle {
    max-width: 55ch;
    margin: var(--space-4) auto 0;
    font-size: var(--fs-xl);
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  .hero-photo .ctas,
  .booking-cta .ctas {
    justify-content: center;
  }

  .what-is {
    max-width: 70ch;
    margin-inline: auto;
    text-align: center;
  }

  .what-is p {
    font-size: var(--fs-lg);
    margin: 0;
    color: var(--color-text-muted);
  }

  .what-is .ctas {
    justify-content: center;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: stretch;
    max-width: 1080px;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .price-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8) var(--space-6);
    text-align: center;
    border-radius: var(--radius-lg);
  }

  .popular {
    margin: 0 0 var(--space-3) 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--color-crimson-soft);
  }

  .tier-dancers {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-subtle);
  }

  .price-card h3 {
    margin: var(--space-1) 0 0 0;
  }

  .price {
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    font-weight: var(--fw-bold);
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--color-primary);
    -webkit-text-fill-color: transparent;
    margin: var(--space-3) 0;
  }

  .price-card ul {
    list-style: none;
    padding: 0;
    color: var(--color-text-muted);
    flex-grow: 1;
    margin: 0 0 var(--space-6) 0;
    font-size: var(--fs-sm);
  }

  .price-card li + li {
    margin-top: var(--space-3);
  }

  .pricing-note {
    margin: var(--space-8) auto 0;
    max-width: 70ch;
    text-align: center;
    color: var(--color-text-muted);
  }

  .dancer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10) var(--space-8);
  }

  @media (min-width: 640px) {
    .dancer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .dancer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .center {
    text-align: center;
    margin-top: var(--space-12);
  }

  .booking-cta {
    position: relative;
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  /* Thin crimson inner line inside the gold deco frame */
  .booking-cta::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(194 30 63 / 0.45);
    border-radius: calc(var(--radius-lg) - 4px);
    pointer-events: none;
  }

  .booking-cta h2 {
    margin: 0;
  }

  .booking-cta p {
    color: var(--color-text-muted);
    margin: var(--space-3) 0 0 0;
  }
</style>
