---
/* Desktop nav — grouped with hover/focus dropdowns so every page is reachable
   from the header, not just five flat links. Structure comes from data/nav.ts. */
import { NAV_GROUPS } from '../data/nav';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => pathname === href.replace(/\/$/, '');
const groupActive = (g) =>
  (g.href && isCurrent(g.href)) || g.links.some((l) => isCurrent(l.href));
---

<nav class="primary-nav" aria-label="Primary">
  <ul class="nav-row">
    <li><a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a></li>

    {NAV_GROUPS.map((group) => (
      <li class="has-menu">
        <a
          href={group.href}
          aria-current={groupActive(group) ? 'page' : undefined}
          aria-haspopup="true"
        >
          {group.label}<span class="caret" aria-hidden="true"></span>
        </a>
        <div class="dropdown">
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  <span class="dd-label">{link.label}</span>
                  {link.note && <span class="dd-note">{link.note}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))}

    <li>
      <a href="/book" class="btn btn--primary book-now" aria-current={pathname === '/book' ? 'page' : undefined}>Book Now</a>
    </li>
  </ul>
</nav>

<style>
  .primary-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .primary-nav {
      display: block;
    }

    .primary-nav ul {
      display: flex;
      gap: var(--space-6);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .primary-nav a {
      color: var(--color-text);
      text-decoration: none;
      font-weight: var(--fw-medium);
      font-size: var(--fs-base);
      padding: var(--space-2) 0;
      border-bottom: 2px solid transparent;
      transition: border-color var(--duration-fast) var(--ease-out);
    }

    .primary-nav a {
      transition: border-color var(--duration-fast) var(--ease-out),
                  color var(--duration-fast) var(--ease-out);
    }

    .primary-nav a:hover,
    .primary-nav a[aria-current='page'] {
      border-bottom-color: var(--color-primary);
      color: var(--color-gold-light);
    }

    .primary-nav ul {
      align-items: center;
    }

    .primary-nav a.book-now {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: var(--space-2) var(--space-5);
      background: var(--gradient-gold);
      color: var(--color-primary-contrast);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--fs-sm);
      border-radius: var(--radius-md);
      border-bottom: none;
      box-shadow: 0 0 24px rgb(212 175 55 / 0.25);
    }

    .primary-nav a.book-now:hover {
      color: var(--color-primary-contrast);
      filter: brightness(1.06);
      box-shadow: 0 0 34px rgb(212 175 55 / 0.5);
    }
  }

  .has-menu { position: relative; }
  .has-menu > a { display: inline-flex; align-items: center; gap: 6px; }
  .caret {
    width: 6px; height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform 160ms ease;
  }
  .has-menu:hover > a .caret,
  .has-menu:focus-within > a .caret { transform: rotate(-135deg) translateY(-1px); }

  .dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 268px;
    max-height: min(70vh, 520px);
    overflow-y: auto;
    background: #0f0a08;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-primary);
    border-radius: var(--radius-md);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.6);
    padding: var(--space-2);
    opacity: 0;
    visibility: hidden;
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms;
    z-index: 80;
  }
  .has-menu:hover .dropdown,
  .has-menu:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .dropdown ul { display: block; padding: 0; margin: 0; list-style: none; }
  .dropdown li a {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 9px var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }
  .dropdown li a:hover { background: color-mix(in oklab, var(--color-primary) 14%, transparent); }
  .dropdown li a[aria-current='page'] {
    background: color-mix(in oklab, var(--color-primary) 18%, transparent);
    color: var(--color-gold-light, #f6e27a);
  }
  .dd-label { font-size: 0.95rem; }
  .dd-note { font-size: 0.75rem; color: var(--color-text-muted); }

  @media (prefers-reduced-motion: reduce) {
    .dropdown { transition: none; }
  }
</style>
