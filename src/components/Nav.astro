---
const items = [
  { label: 'Home', href: '/' },
  { label: 'Dancers', href: '/dancers' },
  { label: 'What Is Burlesque?', href: '/what-is-burlesque' },
  { label: 'FAQ', href: '/faq' },
  { label: 'About', href: '/about' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="primary-nav" aria-label="Primary">
  <ul>
    {items.map(item => {
      const current = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
      return (
        <li>
          <a href={item.href} aria-current={current ? 'page' : undefined}>{item.label}</a>
        </li>
      );
    })}
    <li>
      <a href="/book" class="btn btn--primary book-now" aria-current={pathname === '/book' ? 'page' : undefined}>Book Now</a>
    </li>
  </ul>
</nav>

<style>
  .primary-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .primary-nav {
      display: block;
    }

    .primary-nav ul {
      display: flex;
      gap: var(--space-6);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .primary-nav a {
      color: var(--color-text);
      text-decoration: none;
      font-weight: var(--fw-medium);
      font-size: var(--fs-base);
      padding: var(--space-2) 0;
      border-bottom: 2px solid transparent;
      transition: border-color var(--duration-fast) var(--ease-out);
    }

    .primary-nav a {
      transition: border-color var(--duration-fast) var(--ease-out),
                  color var(--duration-fast) var(--ease-out);
    }

    .primary-nav a:hover,
    .primary-nav a[aria-current='page'] {
      border-bottom-color: var(--color-primary);
      color: var(--color-gold-light);
    }

    .primary-nav ul {
      align-items: center;
    }

    .primary-nav a.book-now {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: var(--space-2) var(--space-5);
      background: var(--gradient-gold);
      color: var(--color-primary-contrast);
      font-weight: var(--fw-semibold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--fs-sm);
      border-radius: var(--radius-md);
      border-bottom: none;
      box-shadow: 0 0 24px rgb(212 175 55 / 0.25);
    }

    .primary-nav a.book-now:hover {
      color: var(--color-primary-contrast);
      filter: brightness(1.06);
      box-shadow: 0 0 34px rgb(212 175 55 / 0.5);
    }
  }
</style>
