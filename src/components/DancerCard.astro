---
import { Image } from 'astro:assets';
import type { Dancer } from '../data/dancers';

export interface Props {
  dancer: Dancer;
  loading?: 'lazy' | 'eager';
}

const { dancer, loading = 'lazy' } = Astro.props;
---

<a href={`/dancers/${dancer.slug}`} class="dancer-card">
  <div class="photo-frame">
    <Image
      src={dancer.image}
      alt={dancer.imageAlt}
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      loading={loading}
    />
  </div>
  <h3>{dancer.name}</h3>
  <p>{dancer.oneLiner}</p>
  <span class="more">Meet {dancer.name}</span>
</a>

<style>
  .dancer-card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    text-align: center;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .dancer-card:hover {
    transform: translateY(-4px);
  }

  .dancer-card .photo-frame {
    transition: box-shadow var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
  }

  .dancer-card:hover .photo-frame {
    border-color: var(--color-primary);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.55), 0 0 28px rgb(212 175 55 / 0.2);
  }

  .dancer-card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
  }

  h3 {
    margin: var(--space-5) 0 0 0;
    font-size: var(--fs-2xl);
  }

  p {
    margin: var(--space-2) auto 0;
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .more {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-primary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .dancer-card:hover .more {
    color: var(--color-gold-light);
  }
</style>
